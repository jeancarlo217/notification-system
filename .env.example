# Copy to .env and fill in real values. The real file is untracked (foundation I5).
# Every key here is a placeholder; none is a working credential.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
# The Compose healthcheck probes the health endpoint on 127.0.0.1, so keep the loopback address
# in this list or a healthy container reads as unhealthy.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Path of the SQLite file. Compose overrides it to the mounted volume.
DJANGO_DATABASE_PATH=db.sqlite3
# Directory the backup_database command writes its copies into. Compose overrides it to the
# mounted ./backups directory, so a person can copy them off the machine. Infrastructure like the
# path above, so unlike the block below it has a default in code.
DJANGO_BACKUP_DIRECTORY=backups

# Deadliner
# Every variable in this block is required and has no default in code (foundation I4), so the
# application refuses to start until all eleven are set.
# The hour the daily list is owed from, 24 hour HH:MM, read in DEADLINER_TIMEZONE below and never
# in the host's own clock (foundation section 5). `7:00` is refused: write both digits.
DEADLINER_SEND_TIME=07:00
# Where the daily list is delivered (foundation section 4). Either the identifier of the
# company WhatsApp group, which is read back from Evolution once the group exists and is never
# typed from memory, or one number in digits only, country code first, no plus sign.
DEADLINER_WHATSAPP_DESTINATION=5500000000000
# The message, in the wording the owner approved (foundation section 4). Seven values, all
# required. The header may reference count and date; a date needs its format spec or it prints
# in ISO order.
DEADLINER_MESSAGE_HEADER="Serviços em aberto, {date:%d/%m/%Y}. {count} serviços nesta lista."
# One line of the list. It may reference client, service, due_date, days_remaining and deadline,
# the last being one of the five phrases below, chosen by the engine.
DEADLINER_MESSAGE_TEMPLATE="• *{client}* | {service} | {deadline} ({due_date:%d/%m/%Y})"
# The five deadline phrases. Each may reference days, which is always a count and never negative:
# two days out or more, one day out, the day itself, one day past, two days past or more.
DEADLINER_DEADLINE_FUTURE="vence em {days} dias"
DEADLINER_DEADLINE_TOMORROW="vence amanhã"
DEADLINER_DEADLINE_TODAY="vence hoje"
DEADLINER_DEADLINE_YESTERDAY="venceu ontem"
DEADLINER_DEADLINE_OVERDUE="venceu há {days} dias"
# The URL segment the whole application is served under. Since the owner decision of 2026-08-31 it
# is a short link meant to be sent to people and it is not a password: whoever holds or guesses it
# can read and write every record. See the README section on it before choosing one.
DEADLINER_SECRET_PATH_SEGMENT=change-me-to-a-long-random-url-segment
# IANA time zone that decides what today is (foundation section 5).
DEADLINER_TIMEZONE=America/Campo_Grande

# Compose only, never read by the configuration boundary: the host side port the web container is
# published on, always bound to 127.0.0.1. The deployment host already runs other services and has
# 8000 taken, so it sets this to a free one; anything in front reaches the application here.
WEB_PORT=8000

# Compose only, like WEB_PORT above: the host side port Evolution is published on, always bound
# to 127.0.0.1. Change it where 8080 is taken, and change EVOLUTION_SERVER_URL below to match.
EVOLUTION_PORT=8080

# Evolution API (self-hosted WhatsApp gateway, foundation section 4). Keys are ours to invent:
# the API key is what the app presents to Evolution, the password is for its own database.
EVOLUTION_API_KEY=change-me-to-a-long-random-string
EVOLUTION_DB_PASSWORD=change-me-to-a-long-random-string
# What Evolution advertises about itself, and what the `just evolution-*` recipes call from the
# host. Not what the application uses.
EVOLUTION_SERVER_URL=http://localhost:8080
# Where the application reaches the gateway, which is a different address from the line above
# whenever the two are not on the same side of the Docker network: inside Compose the service is
# `http://evolution:8080`, and only `just dev` on this machine sees `http://localhost:8080`.
# This one and the instance name below name the gateway; leaving both unset is phase one, which
# runs with no WhatsApp at all, and setting either without the API key is refused at startup.
EVOLUTION_BASE_URL=http://evolution:8080
# The instance created by `just evolution-instance`, and the last segment of every gateway call.
EVOLUTION_INSTANCE_NAME=valeverde
