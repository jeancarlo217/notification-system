# Copy to .env and fill in real values. The real file is untracked (foundation I5).
# Every key here is a placeholder; none is a working credential.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
# The Compose healthcheck probes the health endpoint on 127.0.0.1, so keep the loopback address
# in this list or a healthy container reads as unhealthy.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Path of the SQLite file. Compose overrides it to the mounted volume.
DJANGO_DATABASE_PATH=db.sqlite3

# Deadliner
# Every variable in this block is required and has no default in code (foundation I4), so the
# application refuses to start until all five are set.
# Days before the due date that earn a warning, comma separated (foundation section 5).
DEADLINER_ALERT_THRESHOLDS=30,7,0
# The company WhatsApp number, digits only, country code first, no plus sign.
DEADLINER_WHATSAPP_NUMBER=5500000000000
# Warning text, shown in Portuguese. The only fields it may reference are client, service,
# due_date and days_remaining. The final wording belongs to the owner and is open as OQ-3;
# this placeholder satisfies every test until then.
DEADLINER_MESSAGE_TEMPLATE="Aviso: o servico {service} do cliente {client} vence em {days_remaining} dias, em {due_date}."
# The secret URL segment the whole application is served under. It is a credential: rotate it
# if the link leaks, and never commit the real one.
DEADLINER_SECRET_PATH_SEGMENT=change-me-to-a-long-random-url-segment
# IANA time zone that decides what today is (foundation section 5).
DEADLINER_TIMEZONE=America/Campo_Grande

# Evolution API (self-hosted WhatsApp gateway, foundation section 4). Keys are ours to invent:
# the API key is what the app will present to Evolution, the password is for its own database.
EVOLUTION_API_KEY=change-me-to-a-long-random-string
EVOLUTION_DB_PASSWORD=change-me-to-a-long-random-string
EVOLUTION_SERVER_URL=http://localhost:8080
