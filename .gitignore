# Secrets and data never enter the repository (foundation I5)
.env
.env.*
!.env.example
*.sqlite3
*.sqlite
.evolution-qr.png

# The database copies backup_database writes, and where Compose bind mounts them. The directory
# itself is tracked so a clone has it before Docker creates it as root.
backups/*
!backups/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
build/
dist/
*.egg-info/

# Build artifact of collectstatic, rebuilt by the image and by just setup
staticfiles/

# Agent worktrees created by the toolkit: a nested copy of the tree, so ruff, pytest and
# a careless `git add -A` all reach into it if it is not ignored here.
.claude/worktrees/

# Editors and per-machine files
.vscode/
.idea/
.claude/settings.local.json
